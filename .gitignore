# Environment & Secrets (CRITICAL - DO NOT COMMIT)
.env
.env.*
!.env.example
*.env
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12

# Storage & Backups (CRITICAL - DO NOT COMMIT CUSTOMER DATA)
storage/*
!storage/.gitkeep
*.dump
*.dump.gz
*.sql.gz
*.tar.gz
*.zip
*.7z

# Database Dump files (allow schema migrations)
*.sql
!backend/internal/database/migrations/*.sql

# Go Binaries & Build Output
backend/backupvault-server
backend/bin/
backend/dist/
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.out
*.prof

# Frontend (Node / React / Vite)
node_modules/
frontend/node_modules/
frontend/dist/
frontend/build/
frontend/.cache/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Logs & Temporary Files
*.log
logs/
*.tmp
*.temp
*.swp
*.swo
*~

# Screenshots & Temporary Debug Files
cloud.png
*.png.tmp

# OS & IDE Configuration
.DS_Store
Thumbs.db
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
