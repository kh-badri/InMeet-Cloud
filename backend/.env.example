# BackupVault Environment Configuration Example
# Copy to .env and adjust values for production

# Server
PORT=8080
ENV=development # development | production
APP_URL=http://localhost:8080
TIMEZONE=Asia/Jakarta

# Database
DATABASE_URL=postgres://backupvault:backupvault_secret@127.0.0.1:5432/backupvault_db?sslmode=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10

# Security Secrets (MUST be changed in production, minimum 32 characters)
SESSION_SECRET=super-secret-session-key-change-this-in-production-min32chars
CSRF_SECRET=super-secret-csrf-key-change-this-in-production-min32chars
STORAGE_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef # 64 hex chars (32 bytes)

# Storage
STORAGE_DRIVER=local # local | s3
STORAGE_LOCAL_PATH=/var/www/cloudinmeet/storage/backups

# S3 / MinIO Configuration (Optional, if STORAGE_DRIVER=s3)
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=backupvault
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_USE_SSL=true

# Retention Defaults
RETENTION_TRIGGER_DAY=30 # 30th of month (or last day of month if shorter)
DEFAULT_MIN_KEEP=3
QUARANTINE_DAYS=7

# Initial Admin (Provisioned on first migration if users table is empty)
INITIAL_ADMIN_EMAIL=admin@backupvault.local
INITIAL_ADMIN_PASSWORD=AdminBackupVault2026!

# Notifications (Optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=backupvault@example.com
NOTIFY_EMAIL=admin@example.com
